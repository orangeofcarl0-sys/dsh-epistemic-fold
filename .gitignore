node_modules/
dist/
lib/
*.log
.DS_Store
.env
.env.*
coverage/
.vite/
tsconfig.tsbuildinfo

# vendored DSH source (separate upstream repo, not part of this repo)
vendor/

# Python bytecode (tau2 bridge adapter)
__pycache__/
*.pyc

# Local instrumentation scratch (never committed)
client-instr.js

# EF's own bundle store. The default `bundleRoot` is cwd-relative, so booting
# DSH with EF mounted from inside this repository writes real fold bundles here.
# They are runtime state, not source.
.epistemic-fold/
eval/memory/last_score.json
eval/memory/_*.json
eval/memory/_bundles/
# The regenerable arm's ENVIRONMENT, derived from the committed corpora by
# materialize_corpus.py. Generated rather than tracked for the same reason _bundles is:
# it is a 45 MB projection of data that already lives in corpora/, and a stale copy that
# diverged from the corpus would measure a different arm than the one under test.
eval/memory/regen-env/

# R33 runner scratch directories (reports are committed; workspaces are not)
eval/r33/out/*-work/
eval/r33/out/self-test-runs/
# EF-C1: explicit generate mode writes a candidate here, never into out/.
eval/r33/offline-candidate/
eval/r1-report/out/
# EF-C1: derived identity lists are ~600 KB each and reproducible from the
# accounting command; only the accounting summary is tracked.
eval/c1/out/raw/
# Preflight is a local capability check, not a run record; it records the
# machine's build paths. The review package carries the copy from this round.
eval/r33/out/preflight-report.json
# Authorized live run artifacts stay local; the review package carries the
# reports and traces that are meant to be shared.
eval/r35/runs/

# R36 live run archive (local evidence; reports are summarized under eval/r36/out)
eval/r36/runs/

# R37-B live run archive and generated manifests (local evidence; the
# aggregate result is written to eval/r37/out/r37b-results.json)
eval/r37/runs-b/
eval/r37/manifests-b/
eval/r37/runs-b2/
eval/r37/manifests-b2/
eval/r37/out/r37b-*progress*.json

# R37-C process pilot archive and generated manifests (local evidence; the
# aggregate result and analysis are written to eval/r37c/out/)
eval/r37c/runs-c2/
eval/r37c/manifests-c2/
eval/r37c/runs-c2-smoke/
eval/r37c/manifests-c2-smoke/
eval/r37c/out/*progress*.json

# R37-D live process runs (raw reports, traces, workspaces)
eval/r37d/runs-process/

# EF-E2E: raw run directories (workspaces, full requests, bundles) are local
# evidence. The aggregate results and the per-cell reports' measured fields are
# written to eval/e2e/out/, which IS tracked.
eval/e2e/runs/
eval/e2e/probe-fold.mjs
eval/e2e/candidate/
# EF-R1: the tarball and its throwaway install are rebuildable; the SHA-256 and
# every check are in eval/ef-r1/out/candidate-build.json, which IS tracked.
eval/ef-r1/candidate/
# EF-R2: same rule; the tracked record is eval/r2/out/candidate-build.json.
eval/r2/candidate/

# Full vitest JSON and raw log (the tracked summary is full-tests-summary.json)
eval/e2e/out/full-tests.json
eval/e2e/out/full-tests.log
eval/e2e/out/run-e2e-*.log
