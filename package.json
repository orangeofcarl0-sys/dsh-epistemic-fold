{
  "name": "dsh-epistemic-fold",
  "version": "0.1.0",
  "description": "A contract-preserving context runtime for long-horizon agents on the DeepSeek Harness: exact archive/recall, a monotonic fold frontier, and deterministic current state.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "lib/entry.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/entry.ts",
      "default": "./lib/entry.js"
    },
    "./library": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./plugin": {
      "types": "./src/plugin.ts",
      "default": "./lib/plugin.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "src",
    "client.js",
    "cordis.patch.yml",
    "presets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate-maps": "node scripts/generate-maps.cjs",
    "eval:keyless": "vitest run tests/eval-core.spec.ts tests/eval-corpus.spec.ts tests/eval-longhorizon.spec.ts",
    "eval:longhorizon": "vitest run tests/eval-longhorizon.spec.ts",
    "eval:r1": "vitest run tests/r1a-economics.spec.ts tests/r1b-roi.spec.ts tests/r1d-policy.spec.ts tests/r1e-pareto.spec.ts",
    "eval:r1-report": "vitest run tests/r1-report.spec.ts",
    "eval:r1-live": "vitest run tests/r1-live.spec.ts tests/r1-live-behavior.spec.ts",
    "eval:r2": "vitest run tests/r2a-pressure.spec.ts tests/r2b-admission.spec.ts tests/r2c-root.spec.ts tests/r2d-diet.spec.ts tests/r2e-dominance.spec.ts",
    "eval:r2-live": "vitest run tests/r2-live-behavior.spec.ts",
    "eval:r3": "vitest run tests/r3a-pricing.spec.ts tests/r3b-idle-rebase.spec.ts tests/r3c-framing-seam.spec.ts tests/r3d-economy-gate.spec.ts",
    "eval:r3-live": "vitest run tests/r3f-live-chain.spec.ts",
    "eval:r4": "vitest run tests/r4a-baseline-closure.spec.ts tests/r4a-real-recall.spec.ts tests/r4d-live-billing.spec.ts tests/r4e-noninferiority.spec.ts tests/r4f-preset.spec.ts",
    "eval:r4-live": "vitest run tests/r4d-live-billing.spec.ts tests/r4e-live-noninferiority.spec.ts",
    "eval:rc0": "vitest run tests/rc0a-config-contract.spec.ts tests/rc0b-billing-recorder.spec.ts tests/rc0e-default-regime.spec.ts",
    "eval:rc0-live": "vitest run tests/rc0c-full-wire-billing.spec.ts",
    "eval:rc1": "vitest run tests/rc1a-trigger-reserve.spec.ts tests/rc1b-policy-replay.spec.ts tests/rc1c-shadow-rebase.spec.ts tests/rc1d-cache-contract.spec.ts tests/rc1e-cache-microbench.spec.ts tests/rc11a-certification-semantics.spec.ts tests/rc11b-replay-correction.spec.ts tests/rc12a-recall-loop.spec.ts tests/rc12b-recall-mechanism.spec.ts",
    "eval:rc1-live": "vitest run tests/rc1a-live-reserve.spec.ts tests/rc1e-live-cache.spec.ts tests/rc1f-fold-smoke.spec.ts tests/rc11c-live-smokes.spec.ts tests/rc12a-recall-loop.spec.ts",
    "build": "node scripts/build-plugin.mjs",
    "prepare": "node scripts/build-plugin.mjs",
    "generate-presets": "node scripts/generate-presets.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orangeofcarl0-sys/dsh-epistemic-fold.git"
  },
  "keywords": [
    "deepseek-harness",
    "context-compaction",
    "llm-agents",
    "agent-memory",
    "context-runtime"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-agent": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-atomic-write": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-compaction": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-compaction-basic": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-session": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-session-projection": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-token-meter": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-util-values": ">=0.1.7-rc.2",
    "zod": ">=4.4.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.2"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/ef-economy.patch.yml",
        "./presets/ef-balanced.patch.yml",
        "./presets/ef-quality.patch.yml"
      ]
    },
    "compatibility": {
      "node": ">=22.5.0",
      "dsh": ">=0.1.7-rc.2"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
