{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": false,
    "composite": false,
    "incremental": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    "paths": {
      "@deepseek-ai/dsh-compaction": ["./vendor/deepseek-harness/packages/compaction/compaction/src"],
      "@deepseek-ai/dsh-compaction/*": ["./vendor/deepseek-harness/packages/compaction/compaction/src/*"],
      "@deepseek-ai/dsh-compaction-basic": ["./vendor/deepseek-harness/packages/compaction/compaction-basic/src"],
      "@deepseek-ai/dsh-compaction-basic/*": ["./vendor/deepseek-harness/packages/compaction/compaction-basic/src/*"],
      "@deepseek-ai/dsh-session": ["./vendor/deepseek-harness/packages/core/session/src"],
      "@deepseek-ai/dsh-session/types": ["./vendor/deepseek-harness/packages/core/session/src/types.ts"],
      "@deepseek-ai/dsh-session-projection": ["./vendor/deepseek-harness/packages/session/session-projection/src"],
      "@deepseek-ai/dsh-llm": ["./vendor/deepseek-harness/packages/llm/llm/src"],
      "@deepseek-ai/dsh-llm/brand": ["./vendor/deepseek-harness/packages/llm/llm/src/brand.ts"],
      "@deepseek-ai/dsh-token-meter": ["./vendor/deepseek-harness/packages/llm/token-meter/src"],
      "@deepseek-ai/dsh-agent": ["./vendor/deepseek-harness/packages/core/agent/src"],
      "@deepseek-ai/dsh-agent-loop": ["./vendor/deepseek-harness/packages/core/agent-loop/src"],
      "@deepseek-ai/dsh-agent-loop-testkit": ["./vendor/deepseek-harness/packages/test-support/agent-loop-testkit/src"],
      "@deepseek-ai/dsh-commands/brand": ["./vendor/deepseek-harness/packages/interaction/commands/src/brand.ts"],
      "@deepseek-ai/dsh-commands": ["./vendor/deepseek-harness/packages/interaction/commands/src"],
      "@deepseek-ai/dsh-tools": ["./vendor/deepseek-harness/packages/core/tools/src"],
      "@deepseek-ai/dsh-util-values": ["./vendor/deepseek-harness/packages/util/values/src"],
      "@deepseek-ai/dsh-atomic-write": ["./vendor/deepseek-harness/packages/util/atomic-write/src"],
      "@deepseek-ai/cordis": ["./vendor/cordis/src"],
      "@deepseek-ai/cosmokit": ["./vendor/cosmokit/src"],
      "@deepseek-ai/schemastery": ["./vendor/schemastery/src"]
    }
  }
}
